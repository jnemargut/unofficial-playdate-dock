diff --git a/software/libdvi/dvi.h b/software/libdvi/dvi.h
index a445c26..e1adb78 100644
--- a/software/libdvi/dvi.h
+++ b/software/libdvi/dvi.h
@@ -26,6 +26,16 @@ struct dvi_inst {
 	struct dvi_timing_state timing_state;
 	struct dvi_serialiser_cfg ser_cfg;
     dvi_blank_t blank_settings;
+	// LOCAL PATCH (playdate-dock): vertical repeat as a runtime value rather
+	// than a compile-time macro, because this firmware carries two output modes
+	// in one binary and switches between full and half scanout while running.
+	// Stored as a mask so the IRQ stays branchless: 0 means every scanline,
+	// 1 means every other one. Write vertical_repeat_mask_next, never the live
+	// one: it is latched during vertical sync so the change lands on a frame
+	// boundary. One buffer of producer/consumer disagreement rolls the picture
+	// permanently, because nothing re-syncs the queue to a vertical position.
+	uint32_t vertical_repeat_mask;
+	uint32_t vertical_repeat_mask_next;
 	// Called in the DMA IRQ once per scanline -- careful with the run time!
 	dvi_callback_t scanline_callback;
 
